{
  "name": "360ghar-chatgpt-widgets",
  "version": "1.0.0",
  "description": "ChatGPT App widgets for 360Ghar real estate platform",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-widgets.js",
    "build:watch": "node scripts/build-widgets.js --watch",
    "typecheck": "tsc --noEmit",
    "api:sync": "mkdir -p openapi && cp \"${BACKEND_DIR:-..}/docs/openapi.json\" openapi/openapi.json",
    "api:types": "openapi-typescript openapi/openapi.json --default-non-nullable false -o src/api/schema.gen.ts && node scripts/gen-tool-names.js",
    "test": "TZ=America/Los_Angeles node --test scripts/contract.test.mjs scripts/render.test.mjs",
    "test:browser": "node --test scripts/browser.check.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.20.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0"
  }
}
